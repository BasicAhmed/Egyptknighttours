# ---------- Required ----------
DATABASE_URL="file:./dev.db"                 # Production: libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=""                       # Production only (Turso token)
AUTH_SECRET="change-me-to-a-long-random-string-32+"   # Signs staff logins. Keep secret.
ADMIN_EMAIL="admin@your-domain.com"          # Main admin login. Synced on every start.
ADMIN_PASSWORD="use-12-or-more-characters"   # 8 characters minimum
NEXT_PUBLIC_SITE_URL="https://egyptknight.com" # Your live domain in production, no trailing slash (use http://localhost:3000 locally)
NEXT_PUBLIC_WHATSAPP_NUMBER="201128348803"   # Digits only, with country code

# ---------- Strongly recommended ----------
FILE_ENCRYPTION_KEY=""                       # Dedicated key for passport encryption (long random string). Do not lose it.
CRON_SECRET=""                               # Enables the nightly maintenance job (any long random string)

# ---------- Optional ----------
RESEND_API_KEY=""                            # Sends invoices and itineraries by email
EMAIL_FROM="Egypt Knight Tours <bookings@your-domain.com>"
